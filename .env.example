# Local defaults work without Docker. Copy to .env to override.
INVARIA_DATABASE_URL=sqlite:///./.data/invaria.db
# To use the Compose database from local Python:
# INVARIA_DATABASE_URL=postgresql+psycopg://invaria:invaria-local-dev@127.0.0.1:15432/invaria
INVARIA_OLLAMA_URL=http://127.0.0.1:11434
INVARIA_REASONING_MODEL=gemma4:e4b
INVARIA_EMBEDDING_MODEL=embeddinggemma
INVARIA_MODEL_TIMEOUT=180
INVARIA_SEMGREP_ENABLED=true
# Local trusted workstation only; see README before exposing this application.
INVARIA_API_TOKEN=
